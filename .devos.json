{
  "schema_version": "1.0",
  "project": "devos",
  "id_pattern": "\\b(G\\d{2})\\b",
  "registers": {
    "G": {"path": "BEFUNDE.md", "kind": "heading",
          "heading_pattern": "^#{1,3}\\s+G\\d{2}\\b"}
  },
  "paths": {
    "tasks": "work/tasks",
    "review": "work/review",
    "runs": "work/runs",
    "deliveries": "work/deliveries.jsonl"
