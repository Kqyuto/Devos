# DevOS — Zugangsdaten. Gehoert nach ~/.config/devos/env, NICHT in ein Repo.
#
#   mkdir -p ~/.config/devos
#   cp devos/templates/env.example ~/.config/devos/env
#   chmod 600 ~/.config/devos/env
#   $EDITOR ~/.config/devos/env        # nur die erste Zeile ausfuellen
#
# Danach:  devos preflight --smoke

# ─── Das Einzige, was wirklich fehlt ────────────────────────────────────────
DEVOS_REVIEWER_API_KEY=

# ─── Reviewer: muss einer ANDEREN Modellfamilie angehoeren als der Builder ──
DEVOS_REVIEWER_MODEL=gpt-5
DEVOS_REVIEWER_BASE_URL=https://api.openai.com/v1
DEVOS_REVIEWER_TIMEOUT=600

# ─── Builder: nur der Name; er belegt die Familientrennung ──────────────────
DEVOS_BUILDER_MODEL=claude-opus-5
DEVOS_BUILDER_CMD=bash $DEVOS_HOME/tools/builders/claude_code.sh

# ─── Kosten: ohne diese beiden werden Token gezaehlt, aber nicht bepreist ───
# USD je 1 Mio. Token. Die aktuellen Preise stehen beim Anbieter — eine hier
# eingetragene Zahl ist deine Angabe, keine Messung.
DEVOS_REVIEWER_PRICE_IN=
DEVOS_REVIEWER_PRICE_OUT=

# ─── Nur noetig, wenn der Modellname in keiner Tabelle steht ────────────────
# DEVOS_REVIEWER_FAMILY=openai
# DEVOS_BUILDER_FAMILY=anthropic

# ─── Kontextsuche ───────────────────────────────────────────────────────────
# Leer lassen = eingebauter Index (revisionsgebunden, laeuft ohne Zutun mit).
#
# Graphify anschliessen: Schluessel setzen und DEVOS_GRAPH_CMD aktivieren.
# Danach `devos graphify probe` — es fragt den Server, welche Werkzeuge er hat,
# statt es zu raten.
# DEVOS_GRAPHIFY_KEY=
# DEVOS_GRAPHIFY_URL=https://api.graphify.net/mcp
# DEVOS_GRAPH_CMD=python3 $DEVOS_HOME/tools/graphify_adapter.py
#
# Falls `probe` meldet, dass Werkzeugwahl oder Pflichtfelder nicht passen:
# DEVOS_GRAPHIFY_TOOL=<name>
# DEVOS_GRAPHIFY_ARGS={"feld": "wert"}
